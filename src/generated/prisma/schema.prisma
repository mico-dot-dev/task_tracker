/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bill_expense {
  id             BigInt          @id @default(autoincrement())
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  expense_id     BigInt
  repeating_type DateRepeatType?
  running_bill   Int?            @db.SmallInt
  expense        expense         @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model expense {
  id                     BigInt                   @id @default(autoincrement())
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  name                   String?
  description            String?
  expense_type           String?
  user_id                String?                  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bill_expense           bill_expense[]
  stock                  stock[]
  transaction            transaction[]
  transportation_expense transportation_expense[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stock {
  id          BigInt   @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  curr_amount Int?     @db.SmallInt
  min_amount  Int      @db.SmallInt
  expense_id  BigInt?
  expense     expense? @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transaction {
  id         BigInt             @id @default(autoincrement())
  created_at DateTime           @default(now()) @db.Timestamptz(6)
  expense_id BigInt?
  amount     Int?
  price      Float?
  status     TransactionStatus?
  expense    expense?           @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transportation_expense {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expense_id BigInt?
  cost_list  Int[]    @db.SmallInt
  expense    expense? @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

enum DateRepeatType {
  YEARLY
  MONTHLY
  DAILY
  MANUAL
  BIWEEKLY

  @@schema("public")
}

enum aal_level {
  aal1
  aal2
  aal3

  @@schema("auth")
}

enum code_challenge_method {
  s256
  plain

  @@schema("auth")
}

enum factor_status {
  unverified
  verified

  @@schema("auth")
}

enum factor_type {
  totp
  webauthn
  phone

  @@schema("auth")
}

enum oauth_authorization_status {
  pending
  approved
  denied
  expired

  @@schema("auth")
}

enum oauth_client_type {
  public
  confidential

  @@schema("auth")
}

enum oauth_registration_type {
  dynamic
  manual

  @@schema("auth")
}

enum oauth_response_type {
  code

  @@schema("auth")
}

enum one_time_token_type {
  confirmation_token
  reauthentication_token
  recovery_token
  email_change_token_new
  email_change_token_current
  phone_change_token

  @@schema("auth")
}

enum TransactionStatus {
  PAID
  CANCELLED
  PENDING

  @@schema("public")
}
