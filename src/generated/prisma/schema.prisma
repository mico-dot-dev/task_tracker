generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  created_at DateTime @default(now()) @db.Timestamptz(6)
  email      String   @unique(map: "user_username_key")
  id         String   @id @unique @db.Uuid

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task {
  id               BigInt          @id(map: "tasks_pkey") @default(autoincrement())
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  description      String?         @default("")
  completed        Boolean         @default(false)
  completed_at     DateTime?       @db.Date
  title            String?
  priority_level   Int             @default(0) @db.SmallInt
  due_date         DateTime?       @db.Timestamptz(6)
  task_category_id BigInt?
  repeating_type   DateRepeatType?
  task_category    task_category?  @relation(fields: [task_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model task_category {
  id         BigInt   @id(map: "cat_pkey") @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  title      String   @default("")
  user_id    String   @default(dbgenerated("auth.uid()")) @db.Uuid
  task       task[]

  @@schema("public")
}

